{
  // Cloudflare Workers 静态资源配置
  // 构建命令 python3 build.py 生成 dist/，wrangler deploy 将其作为静态站点发布
  "name": "laptop-xiaomi-web",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    // 严格 .html 模式：*.html 直接响应不重定向
    "html_handling": "none",
    // 未匹配路径（含根路径 /）回退到 index.html 测试索引页
    "not_found_handling": "single-page-application"
  }
}
